# Copia este archivo como .env.local y completa los datos reales.
# .env.local no se sube al repositorio.

# Representante legal (adendas)
VITE_REPRESENTANTE_LEGAL=Nombre del Representante Legal
VITE_DNI_REPRESENTANTE_LEGAL=00000000

# Gerente administrativo (contratos)
VITE_GERENTE_ADMINISTRATIVO=Nombre del Gerente Administrativo
VITE_DNI_GERENTE_ADMINISTRATIVO=00000000

# Pie de página de los documentos de ingreso (confidencialidad, vestimenta)
VITE_PIE_DOCUMENTOS=Dirección de la empresa - Teléfono - correo de RR. HH.

# Gerente General (constancias de trabajo)
VITE_GERENTE_GENERAL=Nombre del Gerente General
VITE_DNI_GERENTE_GENERAL=00000000
VITE_RUC_EMPRESA=00000000000

# Cuenta de prueba "dortiz" (trabajador)
VITE_DORTIZ_NOMBRES=Nombres
VITE_DORTIZ_APELLIDOS=Apellidos
VITE_DORTIZ_DNI=00000000

# Firma del Gerente General: ruta de una imagen dentro de public/privado/ (opcional)
VITE_FIRMA_GERENTE_GENERAL=

# WhatsApp del área de Sistemas (botón "¿Olvidaste tu contraseña?")
VITE_WHATSAPP_SISTEMAS=+51 900 000 000
